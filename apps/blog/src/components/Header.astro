---
import Container from "@meowhx/ui/Container.astro";
import { site } from "@meowhx/ui/site";

const link =
  "rounded-sm text-sm text-text-secondary transition-colors duration-150 hover:text-text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent";
---

<header class="border-b border-border">
  <Container class="flex h-16 items-center justify-between">
    <a
      href="/"
      class="rounded-sm font-semibold tracking-tight focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
    >
      meowhx <span class="font-normal text-text-muted">/ blog</span>
    </a>
    <nav aria-label="Primary">
      <ul class="flex items-center gap-6">
        <li><a class={link} href="/">Articles</a></li>
        <li><a class={link} href={site.portfolioUrl}>Portfolio</a></li>
      </ul>
    </nav>
  </Container>
</header>