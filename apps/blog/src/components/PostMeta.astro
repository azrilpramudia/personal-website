---
type Props = {
  pubDate: Date;
  updatedDate?: Date;
};

const { pubDate, updatedDate } = Astro.props;
const dateFormat = new Intl.DateTimeFormat("en", {
  dateStyle: "long",
  timeZone: "UTC",
});
---

<p class="post-meta">
  Published <time datetime={pubDate.toISOString()}>{dateFormat.format(pubDate)}</time>
  {updatedDate && (
    <>
      {" · Updated "}
      <time datetime={updatedDate.toISOString()}>{dateFormat.format(updatedDate)}</time>
    </>
  )}
</p>
