---
import type { CollectionEntry } from "astro:content";
import { formatDate, readingTime } from "@meowhx/ui/content";

interface Props {
  posts: CollectionEntry<"posts">[];
}
const { posts } = Astro.props;
---

<ul class="divide-y divide-border border-y border-border">
  {
    posts.map((post) => (
      <li class="py-8">
        <article>
          <p class="flex flex-wrap items-center gap-x-3 font-mono text-xs text-text-muted">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            <span aria-hidden="true">·</span>
            <span>{post.data.category}</span>
            <span aria-hidden="true">·</span>
            <span>{readingTime(post.body ?? "")} min read</span>
            {post.data.draft && <span class="text-warning">Draft</span>}
          </p>
          <h2 class="mt-3 text-2xl font-semibold tracking-tight">
            <a
              href={`/posts/${post.id}/`}
              class="rounded-sm transition-colors duration-150 hover:text-accent-text focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
            >
              {post.data.title}
            </a>
          </h2>
          <p class="mt-3 max-w-[65ch] leading-7 text-text-secondary">{post.data.description}</p>
        </article>
      </li>
    ))
  }
</ul>