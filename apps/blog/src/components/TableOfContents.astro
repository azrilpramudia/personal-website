---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}
const items = Astro.props.headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  items.length >= 3 && (
    <nav aria-label="Table of contents" class="mb-10 rounded-lg border border-border p-5">
      <p class="text-sm font-medium">On this page</p>
      <ul class="mt-3 space-y-2">
        {items.map((h) => (
          <li class:list={[h.depth === 3 && "pl-4"]}>
            <a
              href={`#${h.slug}`}
              class="rounded-sm text-sm text-text-secondary transition-colors duration-150 hover:text-text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}