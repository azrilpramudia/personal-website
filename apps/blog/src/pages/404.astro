---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "@meowhx/ui/Container.astro";
import Button from "@meowhx/ui/Button.astro";
---

<BaseLayout title="Page not found">
  <Container class="py-24">
    <p class="font-mono text-sm text-text-muted">404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-4 text-text-secondary">The page you're looking for doesn't exist or has moved.</p>
    <div class="mt-8"><Button href="/">Back to articles</Button></div>
  </Container>
</BaseLayout>