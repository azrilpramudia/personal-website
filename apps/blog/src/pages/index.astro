---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "@meowhx/ui/Container.astro";
import PostList from "../components/PostList.astro";
import { getPublishedPosts } from "../utils/posts";

const posts = await getPublishedPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout>
  <Container class="py-16 md:py-24">
    <div class="max-w-2xl">
      <h1 class="text-[clamp(2.25rem,5vw,3.5rem)] font-semibold leading-[1.05] tracking-[-0.04em]">Blog</h1>
      <p class="mt-4 text-lg leading-relaxed text-text-secondary">
        Technical notes on networking, Linux, infrastructure, and backend development,
        written while learning.
      </p>
    </div>

    {
      tags.length > 0 && (
        <nav aria-label="Topics" class="mt-8">
          <ul class="flex flex-wrap gap-x-4 gap-y-2">
            {tags.map((tag) => (
              <li>
                <a
                  href={`/tags/${tag}/`}
                  class="rounded-sm font-mono text-xs text-text-secondary hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
                >
                  #{tag}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="mt-12">
      {
        posts.length === 0 ? (
          <p class="text-text-secondary">No articles published yet. Check back soon.</p>
        ) : (
          <PostList posts={posts} />
        )
      }
    </div>
  </Container>
</BaseLayout>