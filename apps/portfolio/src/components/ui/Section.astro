---
import Container from "@meowhx/ui/Container.astro";

interface Props {
  id: string;
  title: string;
  description?: string;
  layout?: "split" | "stacked";
}

const { id, title, description, layout = "split" } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="scroll-mt-20 border-t border-border py-24">
  <Container>
    <div class:list={["grid gap-10", layout === "split" && "md:grid-cols-[200px_1fr] md:gap-16"]}>
      <div>
        <h2 id={`${id}-title`} class="text-3xl font-semibold tracking-tight md:text-4xl">{title}</h2>
        {description && <p class="mt-3 max-w-[40ch] text-sm leading-6 text-text-secondary">{description}</p>}
      </div>
      <div><slot /></div>
    </div>
  </Container>
</section>