---
import Section from "../ui/Section.astro";
import { skills } from "../../data/skills";
---

<Section
  id="skills"
  title="Languages & Skills"
  description="Grouped by area. Network Engineering is my primary focus; the rest support it or are still developing."
>
  <div class="grid gap-x-12 gap-y-10 sm:grid-cols-2">
    {
      skills.map((group) => (
        <div>
          <h3 class="text-sm font-medium text-text-primary">{group.category}</h3>
          <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1.5 text-sm text-text-secondary">
            {group.items.map((item, i) => (
              <li>
                {item}
                {i < group.items.length - 1 && <span aria-hidden="true" class="ml-3 text-border">/</span>}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>