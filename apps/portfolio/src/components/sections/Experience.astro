---
import { getCollection } from "astro:content";
import Section from "../ui/Section.astro";
import { formatMonth } from "../../lib/format";

const items = (await getCollection("experience", ({ data }) => data.published || import.meta.env.DEV))
  .map((entry) => entry.data)
  .sort((a, b) => b.start.localeCompare(a.start));
---

<Section id="experience" title="Experience">
  {
    items.length === 0 ? (
      <p class="text-text-secondary">Experience entries are being prepared.</p>
    ) : (
      <ol class="divide-y divide-border border-y border-border">
        {items.map((e) => (
          <li class="py-8">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
              <h3 class="text-lg font-medium">
                {e.role} <span class="text-text-secondary">· {e.organization}</span>
              </h3>
              <p class="shrink-0 font-mono text-xs text-text-muted">
                <time datetime={e.start}>{formatMonth(e.start)}</time>
                {" – "}
                {e.end === "Present" ? "Present" : <time datetime={e.end}>{formatMonth(e.end)}</time>}
              </p>
            </div>

            <p class="mt-1 text-sm text-text-muted">
              {e.type}{e.location && ` · ${e.location}`}
            </p>

            <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-6 text-text-secondary marker:text-text-muted">
              {e.highlights.map((h) => <li>{h}</li>)}
            </ul>

            {e.tools && e.tools.length > 0 && (
              <p class="mt-4 font-mono text-xs text-text-muted">{e.tools.join(" · ")}</p>
            )}

            {!e.published && (
              <p class="mt-4 text-xs text-warning">Draft: not shown in production</p>
            )}
          </li>
        ))}
      </ol>
    )
  }
</Section>