---
import { getCollection } from "astro:content";
import { site } from "@meowhx/ui/site";
import { formatDate, readingTime } from "@meowhx/ui/content";
import Section from "../ui/Section.astro";

const posts = (await getCollection("posts", ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const focus =
  "rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent";
---

{
  posts.length > 0 && (
    <Section id="blog" title="Writing" description="Notes from learning and building, published on the blog.">
      <ul class="divide-y divide-border border-y border-border">
        {posts.map((post) => (
          <li class="py-8">
            <article>
              <p class="flex flex-wrap items-center gap-x-3 font-mono text-xs text-text-muted">
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                <span aria-hidden="true">·</span>
                <span>{post.data.category}</span>
                <span aria-hidden="true">·</span>
                <span>{readingTime(post.body ?? "")} min read</span>
                {post.data.draft && <span class="text-warning">Draft</span>}
              </p>
              <h3 class="mt-3 text-xl font-medium tracking-tight">
                <a
                  href={`${site.blogUrl}/posts/${post.id}/`}
                  class={`transition-colors duration-150 hover:text-accent-text ${focus}`}
                >
                  {post.data.title}
                </a>
              </h3>
              <p class="mt-2 line-clamp-2 max-w-[65ch] text-sm leading-6 text-text-secondary">
                {post.data.description}
              </p>
            </article>
          </li>
        ))}
      </ul>

      <a href={site.blogUrl} class={`mt-8 inline-block text-sm text-accent-text underline-offset-4 hover:underline ${focus}`}>
        View all articles →
      </a>
    </Section>
  )
}