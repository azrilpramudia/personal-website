---
type Props = {
  as?: "div" | "main" | "section";
  class?: string;
};

const { as: Tag = "div", class: className } = Astro.props;
---

<Tag class:list={["container", className]}>
  <slot />
</Tag>

<style>
  .container {
    width: min(100% - 2rem, 72rem);
    margin-inline: auto;
  }
</style>
