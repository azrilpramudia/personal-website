---
import Container from "./Container.astro";
import { site } from "../site";

type Props = {
  currentSite: "portfolio" | "blog";
};

const { currentSite } = Astro.props;
const otherSite =
  currentSite === "portfolio"
    ? { label: "Blog", url: site.blogUrl }
    : { label: "Portfolio", url: site.portfolioUrl };
const socialLinks = [
  { label: "GitHub", url: site.social.github },
  { label: "LinkedIn", url: site.social.linkedin },
  { label: "Email", url: `mailto:${site.email}` },
];
---

<footer class="site-footer">
  <Container class="site-footer__inner">
    <p>&copy; {new Date().getFullYear()} Meowhx</p>
    <nav aria-label="Related sites">
      <a href={otherSite.url}>{otherSite.label}</a>
      {socialLinks.map((link) => (
        <a href={link.url} target="_blank" rel="noreferrer">{link.label}</a>
      ))}
    </nav>
  </Container>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  .site-footer :global(.site-footer__inner) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--color-text-primary);
  }
</style>
