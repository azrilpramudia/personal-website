---
import Container from "./Container.astro";
import { sites, socialLinks } from "../site";

type Props = {
  currentSite: keyof typeof sites;
};

const { currentSite } = Astro.props;
const otherSites =
  currentSite === "portfolio" ? [sites.blog] : [sites.portfolio];
---

<footer class="site-footer">
  <Container class="site-footer__inner">
    <p>&copy; {new Date().getFullYear()} Meowhx</p>
    <nav aria-label="Related sites">
      {otherSites.map((site) => <a href={site.url}>{site.label}</a>)}
      {socialLinks.map((link) => (
        <a href={link.url} target="_blank" rel="noreferrer">{link.label}</a>
      ))}
    </nav>
  </Container>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  .site-footer :global(.site-footer__inner) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--color-text-primary);
  }
</style>
